# Database
DATABASE_URL="postgresql://user:password@localhost:5432/learning_hub?schema=public"
# Direct URL for Prisma migrations (if using connection pooler for DATABASE_URL)
# DIRECT_URL="postgresql://user:password@localhost:5432/learning_hub?schema=public"

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Authentication
SESSION_SECRET="change-me-to-a-secure-random-string-at-least-32-chars"
MCP_BEARER_TOKEN="change-me-to-a-secure-random-bearer-token"

# Initial user setup (used by seed script)
INITIAL_USERNAME="admin"
INITIAL_USER_PASSWORD="change-me-on-first-login"

# Frontend
FRONTEND_ORIGIN="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3001"

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
