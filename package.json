{
  "name": "wonder-bites",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm --filter @wonder-bites/api start",
  "dev": "pnpm --parallel --filter @wonder-bites/api --filter @wonder-bites/web dev",
    "dev:api": "pnpm --filter @wonder-bites/api dev",
    "dev:web": "pnpm --filter @wonder-bites/web dev",
    "build": "pnpm --filter @wonder-bites/shared build && pnpm --parallel --filter @wonder-bites/api --filter @wonder-bites/web build",
    "build:api": "pnpm --filter @wonder-bites/shared build && pnpm --filter @wonder-bites/api build",
    "build:web": "pnpm --filter @wonder-bites/shared build && pnpm --filter @wonder-bites/web build",
    "test": "pnpm --recursive test",
    "test:api": "pnpm --filter @wonder-bites/api test",
    "test:e2e": "pnpm --filter @wonder-bites/e2e test",
    "lint": "pnpm --recursive lint",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "clean": "pnpm --recursive exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
