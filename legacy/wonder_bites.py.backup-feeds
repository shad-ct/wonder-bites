EVERGREEN = [
    ("The Straw Man Fallacy", "https://yourlogicalfallacyis.com/strawman",
     "A straw man misrepresents someone's argument and attacks the weaker version. Explain it with a funny everyday disagreement.",
     "Your Logical Fallacy Is", "Critical Thinking"),
    ("Ad Hominem", "https://yourlogicalfallacyis.com/ad-hominem",
