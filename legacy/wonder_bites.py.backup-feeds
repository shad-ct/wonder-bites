    ("arXiv AI", "https://rss.arxiv.org/rss/cs.AI", "Artificial Intelligence"),
    ("arXiv Language", "https://rss.arxiv.org/rss/cs.CL", "Language & AI"),
    ("arXiv Neuroscience", "https://rss.arxiv.org/rss/q-bio.NC", "Neuroscience"),
    ("Greater Good", "https://greatergood.berkeley.edu/feed", "Human Behavior"),
    ("Psychology Today", "https://www.psychologytoday.com/us/blog/feed", "Psychology"),
